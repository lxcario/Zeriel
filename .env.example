# Zeriel configuration (server-side only; never exposed to the browser bundle).
# Copy to `.env` and fill in. All keys are optional.

# Reliable song search via the YouTube Data API v3. Without it, search falls
# back to public Piped instances (less reliable). Get a key from the Google
# Cloud console (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# Production server (client/src/server/prodServer.ts) bind settings.
PORT=8080
HOST=0.0.0.0

# Path to the yt-dlp binary used for the primary audio backend. Defaults to
# `yt-dlp` resolved on PATH. Set YTDLP_DISABLE=1 to skip the yt-dlp layer.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# YTDLP_DISABLE=1
