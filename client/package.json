{
  "name": "@glitch/client",
  "version": "0.1.0",
  "private": true,
  "description": "Zeriel browser client — Vite + React + TypeScript app shell. Shares @glitch/core.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "start": "node --import tsx src/server/prodServer.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@distube/ytdl-core": "4.16.12",
    "@glitch/core": "0.1.0",
    "gsap": "3.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.0",
    "vite": "8.0.16"
  }
}
